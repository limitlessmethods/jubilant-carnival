      "id": "merge-retry-results",
      "name": "Merge Retry Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [2350, 200]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst retryData = $('Extract Retry Data').first().json;\nconst postResult = item.json;\n\nconst isSuccess = !postResult.error;\nconst currentRetryCount = (retryData.retry_count || 0) + 1;\n\nlet retryStatus;\nlet nextRetryAt = '';\n\nif (isSuccess) {\n  retryStatus = 'succeeded';\n} else if (currentRetryCount >= 3) {\n  retryStatus = 'permanent_failure';\n} else {\n  retryStatus = 'queued';\n  const now = new Date();\n  // Exponential backoff: retry 1 = +30min, retry 2 = +2hr, retry 3 = +8hr\n  const backoffMinutes = [30, 120, 480];\n  const delayMs = (backoffMinutes[currentRetryCount - 1] || 480) * 60 * 1000;\n  nextRetryAt = new Date(now.getTime() + delayMs).toISOString();\n}\n\nreturn [{\n  json: {\n    error_log_id: retryData.error_log_id,\n    master_page_id: retryData.master_page_id,\n    platform: retryData.platform,\n    retry_count: currentRetryCount,\n    retry_status: retryStatus,\n    next_retry_at: nextRetryAt,\n    is_success: isSuccess,\n    is_permanent_failure: retryStatus === 'permanent_failure',\n    new_status: isSuccess ? 'success' : 'failed',\n    error_message: postResult.error || '',\n    content_title: retryData.content_title || ''\n  }\n}];"
      },
      "id": "calculate-retry-result",
      "name": "Calculate Retry Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2600, 200]
    },
    {
      "parameters": {
