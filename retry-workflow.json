      "parameters": {
        "jsCode": "const item = $input.first();\nconst props = item.json;\n\n// Extract fields from the error log entry\nconst masterPageId = props.properties?.['Master Page ID']?.rich_text?.[0]?.plain_text \n  || props.property_master_page_id \n  || props.master_page_id \n  || '';\nconst platform = props.properties?.Platform?.select?.name \n  || props.property_platform \n  || props.platform \n  || '';\nconst mediaUrl = props.properties?.['Media URL']?.url \n  || props.property_media_url \n  || props.media_url \n  || '';\nconst captionUsed = props.properties?.['Caption Used']?.rich_text?.[0]?.plain_text \n  || props.property_caption_used \n  || props.caption_used \n  || '';\nconst retryCount = props.properties?.['Retry Count']?.number \n  || props.property_retry_count \n  || props.retry_count \n  || 0;\nconst errorLogId = props.id || '';\nconst contentTitle = props.properties?.['Content Title']?.rich_text?.[0]?.plain_text \n  || props.property_content_title \n  || props.content_title \n  || '';\n\nreturn [{\n  json: {\n    master_page_id: masterPageId,\n    platform: platform,\n    media_url: mediaUrl,\n    caption_used: captionUsed,\n    retry_count: retryCount,\n    error_log_id: errorLogId,\n    content_title: contentTitle\n  }\n}];"
