              "selectValue": "={{ $json.calculated_status }}"
            },
            {
              "key": "platform_results",
              "richTextValue": "={{ $json.platform_results }}"
            }
          ]
        }
      },
      "id": "update-master-page-retry",
      "name": "Update Master Page",
      "type": "n8n-nodes-base.notion",
