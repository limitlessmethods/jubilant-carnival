            }
          ]
        }
      },
      "id": "update-error-log",
      "name": "Update Error Log Entry",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [2850, 200],
      "credentials": {
        "notionApi": {
          "id": "[YOUR_NOTION_CRED_ID]",
          "name": "[YOUR_NOTION_CRED_NAME]"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst masterPageId = item.master_page_id;\n\nif (!masterPageId) {\n  return [{ json: { skip: true } }];\n}\n\n// We need to check all error log entries for this master page\n// to recalculate the overall status\nreturn [{\n  json: {\n    master_page_id: masterPageId,\n    platform: item.platform,\n    is_success: item.is_success,\n    retry_status: item.retry_status,\n    is_permanent_failure: item.is_permanent_failure,\n    content_title: item.content_title\n  }\n}];"
      },
      "id": "prepare-master-update",
      "name": "Prepare Master Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3100, 200]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {
          "__rl": true,
          "value": "[YOUR_ERROR_LOG_DB_ID]",
          "mode": "id"
        },
        "returnAll": true,
        "filterType": "formula",
        "filterJson": "={\n  \"property\": \"Master Page ID\",\n  \"rich_text\": {\n    \"equals\": \"{{ $json.master_page_id }}\"\n  }\n}"
      },
      "id": "fetch-all-platform-statuses",
      "name": "Fetch All Platform Statuses",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [3350, 200],
      "credentials": {
        "notionApi": {
          "id": "[YOUR_NOTION_CRED_ID]",
          "name": "[YOUR_NOTION_CRED_NAME]"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const allEntries = $input.all().map(i => i.json);\nconst masterPageId = $('Prepare Master Update').first().json.master_page_id;\n\nconst platformStatuses = {};\nfor (const entry of allEntries) {\n  const platform = entry.properties?.Platform?.select?.name || entry.platform || '';\n  const status = entry.properties?.Status?.select?.name || entry.status || '';\n  const retryStatus = entry.properties?.['Retry Status']?.select?.name || entry.retry_status || '';\n  \n  if (platform) {\n    // Use the most recent entry for each platform\n    // succeeded retry or original success = success\n    if (status === 'success' || retryStatus === 'succeeded') {\n      platformStatuses[platform] = 'success';\n    } else if (!platformStatuses[platform]) {\n      platformStatuses[platform] = 'failed';\n    }\n  }\n}\n\nconst allPlatforms = Object.keys(platformStatuses);\nconst failedPlatforms = allPlatforms.filter(p => platformStatuses[p] === 'failed');\nconst successPlatforms = allPlatforms.filter(p => platformStatuses[p] === 'success');\n\nlet calculatedStatus;\nif (failedPlatforms.length === 0) {\n  calculatedStatus = 'Posted';\n} else if (successPlatforms.length === 0) {\n  calculatedStatus = 'Failed';\n} else {\n  calculatedStatus = `Partial - ${failedPlatforms.join(', ')} failed`;\n}\n\nreturn [{\n  json: {\n    master_page_id: masterPageId,\n    calculated_status: calculatedStatus,\n    platform_results: JSON.stringify(platformStatuses),\n    all_succeeded: failedPlatforms.length === 0\n  }\n}];"
      },
      "id": "recalculate-status",
      "name": "Recalculate Overall Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3600, 200]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "update",
        "pageId": {
          "__rl": true,
