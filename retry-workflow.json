      "id": "if-permanent-failure",
      "name": "IF - Permanent Failure",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [4100, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "[YOUR_SLACK_WEBHOOK_URL]",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"blocks\": [\n    {\n      \"type\": \"header\",\n      \"text\": {\n        \"type\": \"plain_text\",\n        \"text\": \":x: Permanent Posting Failure - Manual Action Required\"\n      }\n    },\n    {\n      \"type\": \"section\",\n      \"fields\": [\n        {\n          \"type\": \"mrkdwn\",\n          \"text\": \"*Content:*\\n{{ $('Calculate Retry Result').item.json.content_title }}\"\n        },\n        {\n          \"type\": \"mrkdwn\",\n          \"text\": \"*Platform:*\\n{{ $('Calculate Retry Result').item.json.platform }}\"\n        }\n      ]\n    },\n    {\n      \"type\": \"section\",\n      \"text\": {\n        \"type\": \"mrkdwn\",\n        \"text\": \":warning: *3 retry attempts exhausted.* This post requires manual intervention.\\n\\n*Last Error:* {{ $('Calculate Retry Result').item.json.error_message }}\\n\\n<https://www.notion.so/{{ $('Calculate Retry Result').item.json.master_page_id.replace(/-/g, '') }}|View in Notion>\"\n      }\n    }\n  ]\n}"
      },
      "id": "slack-permanent-failure",
      "name": "Slack - Permanent Failure Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [4350, 100]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst retryData = item.json;\n\n// Mark all platforms as failed since upload failed\nconst currentRetryCount = ($('Extract Retry Data').first().json.retry_count || 0) + 1;\n\nlet retryStatus;\nlet nextRetryAt = '';\n\nif (currentRetryCount >= 3) {\n  retryStatus = 'permanent_failure';\n} else {\n  retryStatus = 'queued';\n  const now = new Date();\n  const backoffMinutes = [30, 120, 480];\n  const delayMs = (backoffMinutes[currentRetryCount - 1] || 480) * 60 * 1000;\n  nextRetryAt = new Date(now.getTime() + delayMs).toISOString();\n}\n\nreturn [{\n  json: {\n    error_log_id: $('Extract Retry Data').first().json.error_log_id,\n    master_page_id: $('Extract Retry Data').first().json.master_page_id,\n    platform: $('Extract Retry Data').first().json.platform,\n    retry_count: currentRetryCount,\n    retry_status: retryStatus,\n    next_retry_at: nextRetryAt,\n    is_success: false,\n    is_permanent_failure: retryStatus === 'permanent_failure',\n    new_status: 'failed',\n    error_message: 'Media re-upload failed: ' + (retryData.error || 'Unknown error'),\n    content_title: $('Extract Retry Data').first().json.content_title || ''\n  }\n}];"
      },
      "id": "handle-reupload-failure",
      "name": "Handle Re-upload Failure",
      "type": "n8n-nodes-base.code",
